# Base URL of your OSRM deployment; no public demo provider is assumed.
OSRM_BASE_URL=http://localhost:5001
# This profile must be present in the deployment and backed by a walking graph.
OSRM_PROFILE=foot
# Enable only if the configured OSRM deployment supports route alternatives.
OSRM_ALTERNATIVES=false
OSRM_TIMEOUT_SECONDS=8
OSRM_MAX_SNAP_DISTANCE_METERS=250
