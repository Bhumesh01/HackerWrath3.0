# Valhalla returns the primary route plus up to two alternatives.
# Use a deployment you operate for production; the public demo is best effort.
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
VALHALLA_TIMEOUT_SECONDS=20

# OpenStreetMap tags add optional lighting and pedestrian-infrastructure context.
OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_SECONDS=12

# Reports are cached in a WAL-mode SQLite database created on first service start.
KAALI_ROUTING_DB_PATH=.data/saheli.sqlite
